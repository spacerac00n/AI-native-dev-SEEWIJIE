# Only the server-side plan generate command loads the root .env.
# Put the real key in .env, never in this example or a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Normal demo startup must leave VERIQA_TEST_MODE unset.
# Playwright sets it only for isolated reset/clock controls.
# Optional VERIQA_DATA_DIR selects a plan-storage root relative to this repository.
